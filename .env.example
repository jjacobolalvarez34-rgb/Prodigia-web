# Copiar a .env.local (que no se versiona) y ajustar.
# Ninguna de estas variables es secreta.

# URL pública de ESTE sitio (metadatos, Open Graph, sitemap).
# Cambiar al dominio propio sin tocar código.
NEXT_PUBLIC_SITE_URL=https://prodigia-presentacion.vercel.app

# Solo para scripts locales: ruta al repo de Prodigia para generar
# datos/actividad.json (npm run actividad). No se usa en Vercel.
PRODIGIA_REPO_PATH=D:/Repositorios/prodigia
